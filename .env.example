# =========================================================================
# DIFY CONFIGURATION
# =========================================================================
# Your Dify Application API Key (from Dify Application -> API Access)
DIFY_API_KEY=

# The base URL of your Dify API service (defaults to https://api.dify.ai/v1)
DIFY_API_BASE_URL=https://api.dify.ai/v1

# Any global inputs required by your Dify chatbot (JSON format)
DIFY_INPUTS_JSON={}

# Optional: The name of the LLM model used in your Dify Application configuration
# (e.g. gpt-4o, gemini-2.5-flash, etc.)
DIFY_MODEL=gpt-4o

# =========================================================================
# CHATWOOT CONFIGURATION
# =========================================================================
# Your Chatwoot Profile Access Token (Avatar -> Profile Settings -> Access Token)
CHATWOOT_API_TOKEN=

# The URL of your Chatwoot instance (defaults to https://app.chatwoot.com)
CHATWOOT_API_BASE_URL=https://app.chatwoot.com

# Your numeric Chatwoot Account ID (visible in your browser URL: /accounts/ID/)
CHATWOOT_ACCOUNT_ID=

# Custom attribute key used to map Chatwoot conversations to Dify conversation IDs
CHATWOOT_CONVERSATION_STATE_KEY=dify_conversation_id


# =========================================================================
# SECURITY & WEBHOOK VALIDATION
# =========================================================================
# Your Chatwoot webhook signing secret (secures endpoint signature checks)
# Comment this out or leave it empty in development to bypass signature validation
CHATWOOT_WEBHOOK_SECRET=

# Webhook request expiry limit in seconds (defends against replay attacks)
CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# SQLite file database path for Coolify self-hosting / local persistence
DATABASE_URL="file:./dev.db"

